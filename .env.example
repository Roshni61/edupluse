# Database connection string
DATABASE_URL=postgresql://edupulse_user:edupulse_password@localhost:5432/edupulse

# JWT Secret for authentication tokens
JWT_SECRET=super-secret-jwt-key-min-32-characters-long-edupulse-2026

# Allowed CORS origins (comma-separated)
